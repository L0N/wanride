# WanRide Production Environment Configuration
# Copy this file to .env.production and update with actual values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=5000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB connection string with authentication
MONGODB_URI=mongodb://wanride_user:your_secure_password@localhost:27017/wanride?authSource=admin

# MongoDB root credentials (for backup script)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_mongo_root_password

# Redis connection
REDIS_URL=redis://:your_redis_password@localhost:6379
REDIS_PASSWORD=your_redis_password

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT secret - Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_32_characters_minimum
JWT_EXPIRE=7d

# API keys for external integrations
VALID_API_KEYS=api_key_1,api_key_2

# IP whitelist for admin endpoints (comma-separated)
ADMIN_IP_WHITELIST=192.168.1.100,10.0.0.50

# Blocked IPs (comma-separated)
BLOCKED_IPS=

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Twilio SMS API
SMS_API_KEY=your_twilio_api_key
SMS_API_SECRET=your_twilio_api_secret
SMS_FROM_NUMBER=+675XXXXXXXX

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# SendGrid Email API
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@wanride.com.pg

# =============================================================================
# FARE CONFIGURATION (K5-ROUNDED)
# =============================================================================
# Inside NCD (Port Moresby) - Flat rate
FARE_NCD_FLAT_RATE=30

# Outside NCD - Distance-based pricing
FARE_BASE=30
FARE_DISTANCE_RATE=2.00
FARE_TIME_RATE=0.50
FARE_FREE_DISTANCE_KM=10
FARE_RETURN_FEE_PERCENTAGE=25

# Airport addon (Jackson's International)
FARE_AIRPORT_ADDON=10

# Commission rate (20% = 0.20)
COMMISSION_RATE=0.20

# =============================================================================
# NCD BOUNDARY COORDINATES (PORT MORESBY)
# =============================================================================
NCD_BOUNDARY_NORTH=-9.3
NCD_BOUNDARY_SOUTH=-9.6
NCD_BOUNDARY_EAST=147.3
NCD_BOUNDARY_WEST=147.0

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# AWS S3 for backups
S3_BUCKET=wanride-backups
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-2

# =============================================================================
# MONITORING & NOTIFICATIONS
# =============================================================================
# Slack webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Log level (error, warn, info, http, debug)
LOG_LEVEL=info

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Frontend URL for CORS
FRONTEND_URL=https://wanride.com.pg

# Socket.io CORS origin
SOCKET_CORS_ORIGIN=https://wanride.com.pg

# =============================================================================
# SSL CONFIGURATION
# =============================================================================
# SSL certificate paths (for nginx)
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Database connection pool
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2

# Redis connection pool
REDIS_MAX_CONNECTIONS=20

# Session configuration
SESSION_SECRET=your_session_secret_key
SESSION_MAX_AGE=86400000

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_SMS_VERIFICATION=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_ANALYTICS=true
ENABLE_DEBUG_MODE=false

# =============================================================================
# BUSINESS CONFIGURATION
# =============================================================================
# Company information
COMPANY_NAME=WanRide PNG
COMPANY_PHONE=+675XXXXXXXX
COMPANY_EMAIL=support@wanride.com.pg
COMPANY_ADDRESS=Port Moresby, Papua New Guinea

# Operating hours (PNG timezone)
OPERATING_HOURS_START=05:00
OPERATING_HOURS_END=23:00

# Maximum ride distance (km)
MAX_RIDE_DISTANCE=100

# Driver shift duration (hours)
MAX_SHIFT_DURATION=12

# =============================================================================
# DEVELOPMENT OVERRIDES (Remove in production)
# =============================================================================
# Uncomment for development/testing
# NODE_ENV=development
# LOG_LEVEL=debug
# ENABLE_DEBUG_MODE=true
