# API Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_SOCKET_URL=http://localhost:5000

# Mapbox Configuration (for maps)
REACT_APP_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# App Configuration
REACT_APP_NAME=WanRides
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# Feature Flags
REACT_APP_ENABLE_MAPS=true
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_ANALYTICS=false

# File Upload Configuration
REACT_APP_MAX_FILE_SIZE=5242880
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# OTP Configuration
REACT_APP_OTP_LENGTH=6
REACT_APP_OTP_TIMEOUT=300

# Referral Configuration
REACT_APP_REFERRAL_CODE_LENGTH=8

# Socket.io Configuration
REACT_APP_SOCKET_RECONNECTION_ATTEMPTS=5
REACT_APP_SOCKET_RECONNECTION_DELAY=1000

# Development Configuration
REACT_APP_DEBUG=true
GENERATE_SOURCEMAP=true

# Build Configuration
BUILD_PATH=build
PUBLIC_URL=/
