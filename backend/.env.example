# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/wanride_fleet
MONGODB_TEST_URI=mongodb://localhost:27017/wanride_fleet_test

# JWT Configuration
JWT_SECRET=wanride_fleet_jwt_secret_2026_make_this_very_long_and_random
JWT_REFRESH_SECRET=wanride_fleet_refresh_secret_2026_make_this_different_and_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Twilio Configuration (Phone/OTP Verification)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Cloudinary Configuration (File Upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Official WanTek PNG Contact)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=frank@wantekpng.com
EMAIL_PASS=your_email_password
SUPPORT_EMAIL=frank@wantekpng.com
BUSINESS_NAME=WanTek PNG
BUSINESS_CONTACT=frank@wantekpng.com

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# ===== FARE CALCULATION SETTINGS =====

# Inside NCD (Port Moresby) - Flat Rate
FARE_NCD_FLAT_RATE=30

# Outside NCD (Beyond Port Moresby) - Distance-Based
FARE_BASE=30
FARE_DISTANCE_RATE=2.00
FARE_TIME_RATE=0.50
FARE_FREE_DISTANCE_KM=10

# Return Trip Fee (for outside NCD trips)
FARE_RETURN_FEE_ENABLED=true
FARE_RETURN_FEE_PERCENTAGE=25

# Airport Handling (Jackson's International)
FARE_AIRPORT_ADDON=10

# NCD Boundary (Port Moresby Geographic Limits)
# Approximate boundary - adjust based on actual NCD limits
NCD_BOUNDARY_NORTH=-9.3
NCD_BOUNDARY_SOUTH=-9.6
NCD_BOUNDARY_EAST=147.3
NCD_BOUNDARY_WEST=147.0

# Jackson's International Airport Coordinates
AIRPORT_LAT=-9.4434
AIRPORT_LNG=147.2200
AIRPORT_RADIUS_KM=0.5

# ===== COMMISSION SETTINGS =====
COMMISSION_RATE=0.20
COMMISSION_PAYOUT_FREQUENCY=WEEKLY
COMMISSION_PAYOUT_DAY=FRIDAY
COMMISSION_PAYOUT_TIME=18:00

# ===== K5 ROUNDING =====
CURRENCY_ROUNDING_INCREMENT=5

# PNG Specific Configuration
DEFAULT_COUNTRY_CODE=675
DEFAULT_TIMEZONE=Pacific/Port_Moresby
DEFAULT_CURRENCY=PGK

# Socket.io Configuration
SOCKET_CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
